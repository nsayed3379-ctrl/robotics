# Copy to .env.local for local dev. On Vercel, add each of these under
# Settings -> Environment Variables. `npm run setup <admin-password>` fills in
# the last four automatically (appends them to .env.local).

# Google Cloud OAuth client (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Written by scripts/setup.mjs
GOOGLE_REFRESH_TOKEN=
SHEET_ID=
FOLDER_ID=
SESSION_SECRET=
